# SQLite for local development — creates backend/prisma/dev.db
# (For production, switch the Prisma schema provider to "postgresql" and set a Postgres URL, e.g.)
# DATABASE_URL="postgresql://user:password@host:5432/ai_crm?schema=public"
DATABASE_URL="file:./dev.db"