# Backend — copy this to backend/.env
OPENAI_API_KEY=sk-...your-openai-key-here...
PORT=5000
NODE_ENV=development
# SQLite for local dev — creates backend/prisma/dev.db
# (Production: switch Prisma schema provider to "postgresql" and use a Postgres URL)
DATABASE_URL="file:./dev.db"

# Frontend — copy this to frontend/.env (optional, defaults to localhost)
NEXT_PUBLIC_API_URL=http://localhost:5000
